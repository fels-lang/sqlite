#import std.build.{ Build };

build :: fn(b: Build) {
    // What the users of this package link with: the folder with sqlite3.lib, and the DLL,
    // copied next to their programs.
    b.provide_lib_path("lib");
    b.provide_runtime_file("lib/sqlite3.dll");

    b.out_root("bin");
    demo := b.executable("demo", "examples/demo.fels");
    demo.lib_path("lib");
    demo.runtime_file("lib/sqlite3.dll");
    b.run_step("run", demo);
    b.default(demo);
}
